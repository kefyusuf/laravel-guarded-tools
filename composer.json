{
    "name": "kefyusuf/laravel-guarded-tools",
    "description": "Guarded tools and assurance tests for Laravel AI agents: workspace isolation, honest failures and evidence on every tool call.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "agents", "multi-tenancy", "security", "testing", "packstub", "laravel-ai"],
    "homepage": "https://github.com/kefyusuf/laravel-guarded-tools",
    "authors": [
        { "name": "Yusuf Kef", "homepage": "https://github.com/kefyusuf" }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/ai": "^1.0",
        "packstub/agents": "^1.7.1"
    },
    "autoload": {
        "psr-4": {
            "GuardedTools\\": "packages/guarded-tools/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GuardedTools\\GuardedToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
