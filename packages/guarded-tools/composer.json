{
    "name": "kefyusuf/laravel-guarded-tools",
    "description": "Guarded tools and assurance tests for Laravel AI agents (working name).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "laravel/ai": "^1.0"
    },
    "suggest": {
        "packstub/agents": "For tools on packstub/agents (GuardedTools\\Packstub\\GuardedAgentTool); 1.7.1 or newer."
    },
    "conflict": {
        "packstub/agents": "<1.7.1"
    },
    "autoload": {
        "psr-4": {
            "GuardedTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GuardedTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GuardedTools\\GuardedToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
